# Subrails environment configuration.
# Copy this file to .env and fill in the values. Never commit real secrets.

# ---------------------------------------------------------------------------
# All components
# ---------------------------------------------------------------------------

# Network: "testnet" or "mainnet".
SUBRAILS_NETWORK=testnet

# Soroban RPC endpoint for the network.
SUBRAILS_RPC_URL=https://soroban-testnet.stellar.org

# Stellar network passphrase.
SUBRAILS_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Set to "true" to enable CAP-71 delegated credentials (Protocol 27 networks).
SUBRAILS_PROTOCOL27=true

# ---------------------------------------------------------------------------
# Deployed contracts. These are filled in after the contracts are deployed.
# Leave blank until then.
# ---------------------------------------------------------------------------

# mandate-policy contract id.
MANDATE_POLICY_ID=

# Installed subrails-account wasm hash.
SUBRAILS_ACCOUNT_WASM_HASH=

# mandate-registry contract id.
MANDATE_REGISTRY_ID=

# ---------------------------------------------------------------------------
# Indexer
# ---------------------------------------------------------------------------

# Postgres connection string for the indexer.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/subrails

# Ledger number to begin ingesting from. Leave blank to start at the network
# current ledger on first run.
INDEXER_START_LEDGER=

# Port for the indexer read API.
INDEXER_API_PORT=8080

# ---------------------------------------------------------------------------
# Frontend (Next.js, values are inlined at build time)
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUBRAILS_NETWORK=testnet

# Filled in after the contracts are deployed.
NEXT_PUBLIC_MANDATE_POLICY_ID=
NEXT_PUBLIC_MANDATE_REGISTRY_ID=

# Base URL of the indexer read API.
NEXT_PUBLIC_INDEXER_API_URL=http://localhost:8080
